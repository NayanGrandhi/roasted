# REQUIRED for real roasts. Free key, no credit card: https://aistudio.google.com/apikey
# Without it the app runs in demo mode with placeholder roasts.
GEMINI_API_KEY=

# Optional: change models (both are on Gemini's free tier).
# The fallback is used automatically when the main model's free quota runs out.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: raises GitHub API limits from 60 to 5000 requests/hour for GitHub mode.
# Create one (no scopes needed) at https://github.com/settings/tokens
# GITHUB_TOKEN=

# Optional: roasts per IP per hour (default 20). Protects your free AI quota.
# RATE_LIMIT_PER_HOUR=20

# Optional: your deployed URL, used for link previews.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
